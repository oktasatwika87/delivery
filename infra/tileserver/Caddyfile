# Caddyfile - HTTPS reverse proxy for tileserver-gl
#
# Deploy to VPS:
#   scp infra/tileserver/Caddyfile user@vps:/etc/caddy/Caddyfile
#   ssh user@vps 'caddy fmt --overwrite /etc/caddy/Caddyfile'
#   ssh user@vps 'caddy reload --config /etc/caddy/Caddyfile'
#
# Prerequisites on VPS:
#   - Docker + Docker Compose installed
#   - tileserver-gl container running on port 8080
#   - DNS A record pointing to VPS IP (e.g., tiles.example.com -> 1.2.3.4)
#
# Caddy auto-provisions Let's Encrypt certificates - no manual cert management.
# The wildcard cert is sufficient for a single subdomain.

tiles.example.com {
    reverse_proxy localhost:8080

    # Optional: log to stdout for docker logs
    log {
        output: stdout
    }
}
