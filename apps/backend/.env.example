// Sample env file. Copy ke `.env` (di-gitignore) dan sesuaikan nilainya.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/delivery?schema=public"
PORT=3000
NODE_ENV=development

# Staged reassignment timeouts (dalam menit).
# ASSIGNED/PREPARING: driver belum jalan / belum ada kontak fisik ke customer.
# OUT_FOR_DELIVERY: driver udah bawa barang, COD bisa collect kapan saja.
REASSIGN_TIMEOUT_PREPARING_MINUTES=15
REASSIGN_TIMEOUT_DELIVERY_MINUTES=50