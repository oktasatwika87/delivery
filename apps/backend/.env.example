# Salin jadi `.env` (di-gitignore) lalu sesuaikan nilainya.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/delivery_db?schema=public"
PORT=3000
NODE_ENV=development

# Staged reassignment timeouts (dalam menit).
# ASSIGNED/PREPARING: driver belum jalan / belum ada kontak fisik ke customer.
# OUT_FOR_DELIVERY: driver udah bawa barang, COD bisa collect kapan saja.
REASSIGN_TIMEOUT_PREPARING_MINUTES=15
REASSIGN_TIMEOUT_DELIVERY_MINUTES=50

# SMTP configuration untuk email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@delivery.app

# Email tujuan untuk orphan COD notification
ORPHAN_NOTIFY_EMAIL=support@example.com

# Kunci tanda tangan token login, wajib diisi (server gagal start kalau kosong)
JWT_SECRET=
