{
  "name": "delivery-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first delivery app monorepo (React Native + NestJS, pnpm workspaces)",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "lint": "pnpm -r --parallel run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "pnpm -r --parallel run typecheck",
    "build:shared": "pnpm --filter @delivery/shared build",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache .turbo"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0"
  }
}